# Shared OpenAI key used by ALL users of this local instance.
# Powers: AI Coach chat, meal-photo recognition, body-analysis narrative, workout plan write-ups.
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: override default chat model (must support vision for meal-photo recognition)
OPENAI_MODEL=gpt-4o-mini
