# Shared Google Gemini key used by ALL users of this local instance (free tier works).
# Powers: AI Coach chat, meal-photo recognition, body-analysis narrative, recipe generation.
# Get a free key at https://aistudio.google.com/apikey
GEMMINI_API_KEY=your-key-here

# Optional: override default model (must support vision for meal-photo recognition).
# gemini-flash-lite-latest is used by default — verified working on the free tier.
GEMINI_MODEL=gemini-flash-lite-latest
